(in-package "CCL")
(defun count-matches (pattern text)
  (loop with start = 0 for p = (search pattern text :start2 start) while p count t do (setq start (1+ p))))
(defun dis (f) (with-output-to-string (*standard-output*) (disassemble f)))
(format t "~&;;;;;;;; ~a~%" (lisp-implementation-version))
(dolist (form '((lambda (x y) (+ x y))
                (lambda (x) (declare (fixnum x)) (1+ x))
                (lambda (x y) (eql x y))))
  (format t "~&~%;;;;;;;; ~s~%~a" form (dis (compile nil form))))
;; Every function in the image disassembles without error; count named subprim calls.
(let ((n 0) (errors 0) (named 0) (raw 0))
  (do-all-symbols (sym)
     (let ((f (and (fboundp sym) (not (macro-function sym)) (not (special-operator-p sym)) (fdefinition sym))))
     (when (and (functionp f) (not (typep f 'standard-generic-function)))
       (incf n)
       (handler-case
           (let ((text (dis f)))
             (incf named (count-matches ".SP" text))
             (incf raw (count-matches "(ldr imm0 (:@ rcontext imm0))" text))
             (incf raw (count-matches "(ldr imm1 (:@ rcontext imm1))" text)))
         (error (c) (incf errors) (when (< errors 5) (format t "~&ERROR ~s: ~a~%" f c)))))))
  (format t "~&RESULT functions ~d, errors ~d, named subprims ~d, rcontext-indexed loads ~d~%" n errors named raw))
(format t "~&RESULT round-trip: ~s~%" (ignore-errors (load "ccl:compiler;ARM64;tests.lisp") (arm64::run-round-trip-tests)))
(quit)
